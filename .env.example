AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PAT=your-personal-access-token
AZURE_DEVOPS_PROJECT=your-project-name
AZURE_DEVOPS_TEAM=your-team-name

# --- shelf_monitor -----------------------------------------------------------
# Todas as variaveis abaixo sao opcionais: o monitor roda so com fontes publicas.

# Onde ficam snapshots, extratos e relatorios (default: ./data)
SHELF_DATA_DIR=data
SHELF_HTTP_TIMEOUT=60

# Override da base URL do Open Finance por plataforma, quando a descoberta pelo
# diretorio oficial nao resolver (o path /open-banking/opendata-investments/v1
# e acrescentado automaticamente).
# OPEN_FINANCE_BASE_URL_BTG=https://api.btgpactual.com
# OPEN_FINANCE_BASE_URL_ITAU=https://api.itau.com.br

# Binario do Chromium para os coletores que usam navegador (XP, BTG e Itau).
# Util quando o ambiente ja tem um Chromium cuja versao nao bate com a que o
# pacote playwright espera baixar.
# SHELF_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome

# Grava, a cada renderizacao, o HTML renderizado, todas as requisicoes e os
# payloads JSON em data/cache/debug/<casa>/. E o material para corrigir um
# parser quando uma lista muda de layout - ligue quando uma casa vier vazia.
# SHELF_BROWSER_DEBUG=1

# Abre o navegador com janela, usando o Chrome instalado (em vez do Chromium sem
# janela). NAO e necessario para XP e Itau: o 403 daquelas CDNs vinha do headless
# shell do Playwright, e o coletor passou a usar o Chromium completo em
# --headless=new. Ligue so se alguma lista exigir interacao visivel ou a sessao
# logada do seu navegador. Requer sessao grafica.
# SHELF_BROWSER_HEADED=1
# SHELF_BROWSER_CHANNEL=chrome

# Coletores autenticados (v2): storage_state do Playwright exportado apos login
# manual. Sem isso, so as prateleiras publicas sao coletadas.
# SHELF_AUTH_STATE_NU=data/sessions/nu.json

# Envio do digest por SMTP (opcional - por padrao o monitor so gera os arquivos)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# Comdinheiro (assinatura paga) para o `etf-bruto`: sem usuario e senha a fonte
# fica "sem configuracao" e so a pasta data/etf/entrada/comdinheiro/ e lida. As
# consultas ficam em data/etf/manual/comdinheiro_consultas.csv. O endpoint
# abaixo e o padrao; se o trecho de codigo que a propria Comdinheiro gera no
# botao de API mostrar outro, troque aqui.
# COMDINHEIRO_USUARIO=
# COMDINHEIRO_SENHA=
# COMDINHEIRO_API_URL=https://www.comdinheiro.com.br/Clientes/API/EndPoint001.php?code=import_data
