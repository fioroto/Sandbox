.env
__pycache__/
*.pyc
.venv/
venv/

# shelf_monitor: downloads brutos da CVM (dezenas de MB) e caches - so o
# extrato filtrado pela watchlist e versionado.
data/cvm/raw/
data/cache/
data/sessions/

# shelf_monitor: base geral do mercado (centenas de MB de CSV)
data/market/

# shelf_monitor: artefatos do Excel, nao entregaveis.
# "~$nome.xlsx" e o arquivo de trava que o Excel cria enquanto a pasta esta
# aberta e apaga ao fechar; "nome-2.xlsx" e a copia que _salvar grava quando a
# pasta alvo esta presa. Os dois apareciam no `git add` do diretorio de
# relatorios que o `run --git-commit` faz.
~$*.xlsx
data/reports/*-[0-9].xlsx

# shelf_monitor: captura bruta do `etf-bruto` (reproduzivel na origem, centenas
# de MB) e a pasta onde a pessoa solta exportacoes da Comdinheiro e carteiras
# de gestora (dado licenciado). O que gente preenche (data/etf/manual/) e o
# universo/cobertura seguem versionados.
data/etf/bruto/
data/etf/entrada/

# shelf_monitor: lista distribuivel (fundos que a XP distribui ou pode
# distribuir) - dado comercial interno. O modelo com o cabecalho
# (data/distribuivel/modelo.csv) segue versionado.
data/distribuivel/entrada/
